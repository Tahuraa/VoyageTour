<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain HTTP only to the local dev backend, so debug builds can
     reach it without pulling TLS into the loop; production endpoints
     should be HTTPS and don't need an entry here. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.1.8</domain>
        <domain includeSubdomains="false">192.168.0.105</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
